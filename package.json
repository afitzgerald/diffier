{
  "name": "diffier",
  "productName": "Diffier",
  "version": "0.1.0",
  "description": "IntelliJ-style Git diff editor for macOS",
  "author": "Alan Fitzgerald",
  "license": "MIT",
  "repository": "github:afitzgerald/diffier",
  "main": "main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.highlighter.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json && yarn build:preload",
    "start": "yarn build && electron .",
    "smoke": "yarn build && DIFFIER_SMOKE=1 electron --no-sandbox .",
    "test": "yarn build && node test/git.test.js && node test/keymap.test.js && node test/themes.test.js && node test/languages.test.js && node test/whats-new.test.js && node scripts/third_party_notices.mjs --check",
    "build:highlighter": "esbuild renderer/highlighter-entry.ts --bundle --format=iife --minify --log-level=warning --outfile=renderer/highlighter.js",
    "build:mermaid": "esbuild renderer/mermaid-entry.ts --bundle --format=iife --minify --log-level=warning --banner:js=\"(function(define){\" --footer:js=\"})();\" --outfile=renderer/mermaid.js",
    "build:preload": "esbuild main/preload.ts --bundle --platform=node --format=cjs --external:electron --log-level=warning --outfile=main/preload.js",
    "postinstall": "yarn build:highlighter || node -e \"console.warn('shiki highlighter bundle skipped; falling back to built-in grammars')\"; yarn build:mermaid || node -e \"console.warn('mermaid bundle skipped; mermaid fences will render as plain code blocks')\"",
    "dist": "yarn build && yarn build:highlighter && yarn build:mermaid && BUILD_NUMBER=${BUILD_NUMBER:-dev} electron-builder --mac",
    "notices": "node scripts/third_party_notices.mjs"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0"
  },
  "resolutions": {
    "dompurify": "3.4.18",
    "app-builder-lib/minimatch": "^11.0.1",
    "@electron/universal/minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@shikijs/monaco": "^4.6.0",
    "@types/node": "^24",
    "electron": "^45.3.2",
    "electron-builder": "26.18.1",
    "esbuild": "^0.28.2",
    "mermaid": "^12.3.0",
    "playwright-core": "^1.65.1",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.fitzgeraldweb.diffier",
    "productName": "Diffier",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "build/icon.png",
      "!main/**/*.ts",
      "!renderer/**/*.ts",
      "!renderer/global.d.ts",
      "node_modules/monaco-editor/min/**",
      "node_modules/monaco-editor/min-maps/**",
      "package.json",
      "WhatsNew.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "icon": "build/icon.icns",
    "afterSign": "build/afterSign.js",
    "artifactName": "${productName}-build${env.BUILD_NUMBER}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "copyright": "Copyright © 2026 Alan Fitzgerald and contributors",
    "extraResources": [
      {
        "from": "build/diffier",
        "to": "bin/diffier"
      }
    ]
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
