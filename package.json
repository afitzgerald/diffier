{
  "name": "diffier",
  "productName": "Diffier",
  "version": "0.1.0",
  "description": "IntelliJ-style Git diff editor for macOS",
  "author": "Alan Fitzgerald",
  "license": "MIT",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "DIFFIER_SMOKE=1 electron --no-sandbox .",
    "test": "node test/git.test.js",
    "dist": "electron-builder --mac"
  },
  "dependencies": {
    "monaco-editor": "^0.49.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.diffier.app",
    "productName": "Diffier",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "node_modules/monaco-editor/min/**",
      "node_modules/monaco-editor/min-maps/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "darkModeSupport": true
    }
  }
}
