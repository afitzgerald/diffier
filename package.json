{
  "name": "diffier",
  "productName": "Diffier",
  "version": "0.1.0",
  "description": "IntelliJ-style Git diff editor for macOS",
  "author": "Alan Fitzgerald",
  "license": "MIT",
  "repository": "github:afitzgerald/diffier",
  "main": "main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.highlighter.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json && yarn build:preload",
    "start": "yarn build && electron .",
    "smoke": "yarn build && DIFFIER_SMOKE=1 electron --no-sandbox .",
    "test": "yarn build && node test/git.test.js && node test/keymap.test.js && node test/themes.test.js && node test/languages.test.js",
    "build:highlighter": "esbuild renderer/highlighter-entry.ts --bundle --format=iife --minify --log-level=warning --outfile=renderer/highlighter.js",
    "build:mermaid": "esbuild renderer/mermaid-entry.ts --bundle --format=iife --minify --log-level=warning --outfile=renderer/mermaid.js",
    "build:preload": "esbuild main/preload.ts --bundle --platform=node --format=cjs --external:electron --log-level=warning --outfile=main/preload.js",
    "postinstall": "yarn build:highlighter || node -e \"console.warn('shiki highlighter bundle skipped; falling back to built-in grammars')\"; yarn build:mermaid || node -e \"console.warn('mermaid bundle skipped; mermaid fences will render as plain code blocks')\"",
    "dist": "yarn build && yarn build:highlighter && yarn build:mermaid && BUILD_NUMBER=${BUILD_NUMBER:-dev} electron-builder --mac"
  },
  "dependencies": {
    "monaco-editor": "^0.56.0"
  },
  "resolutions": {
    "dompurify": "3.4.13"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@shikijs/monaco": "^4.4.3",
    "@types/node": "^26.4.0",
    "electron": "^44.1.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "mermaid": "^11.17.2",
    "playwright-core": "^1.62.1",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.fitzgeraldweb.diffier",
    "productName": "Diffier",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "build/icon.png",
      "!main/**/*.ts",
      "!renderer/**/*.ts",
      "!renderer/global.d.ts",
      "node_modules/monaco-editor/min/**",
      "node_modules/monaco-editor/min-maps/**",
      "package.json"
    ],
    "icon": "build/icon.icns",
    "afterSign": "build/afterSign.js",
    "artifactName": "${productName}-build${env.BUILD_NUMBER}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    }
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
